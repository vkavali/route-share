{
  "name": "route-share-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "npm run check:native && expo start",
    "sync:shared": "npm run check:native && node scripts/sync-shared.mjs && node scripts/sync-leaflet.mjs && node scripts/sync-icons.mjs",
    "check:translations": "node scripts/sync-shared.mjs --check",
    "typecheck": "tsc --noEmit",
    "export:ios": "npm run sync:shared && expo export --platform ios --output-dir dist/ios",
    "export:android": "npm run sync:shared && expo export --platform android --output-dir dist/android",
    "export:all": "npm run sync:shared && npm run typecheck && expo export --platform ios --output-dir dist/ios && expo export --platform android --output-dir dist/android",
    "android": "npm run check:native && expo run:android",
    "ios": "npm run check:native && expo run:ios",
    "test:voice": "node --test src/voice/voice.test.cjs src/voice/capture.test.cjs src/voice/recording.test.cjs src/voice/transport.test.cjs",
    "check:native": "node scripts/check-native-dependencies.cjs"
  },
  "dependencies": {
    "@react-native-community/datetimepicker": "8.4.4",
    "expo": "~54.0.0",
    "expo-asset": "12.0.13",
    "expo-audio": "1.1.1",
    "expo-clipboard": "8.0.8",
    "expo-constants": "18.0.14",
    "expo-crypto": "~15.0.0",
    "expo-document-picker": "14.0.8",
    "expo-file-system": "19.0.24",
    "expo-font": "~14.0.12",
    "expo-location": "~19.0.0",
    "expo-secure-store": "~15.0.0",
    "expo-sharing": "14.0.8",
    "expo-speech": "14.0.8",
    "expo-splash-screen": "31.0.13",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-webview": "13.15.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  }
}
