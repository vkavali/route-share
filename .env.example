# Development accounts (driver, passenger, passenger2, admin) all use this password.
# Replace it before sharing access beyond your own machine.
BETA_PASSWORD=local-beta-only
BETA_DATABASE=work/beta.sqlite3
# HOST and PORT are optional; HOST is restricted to localhost/loopback.
HOST=127.0.0.1
PORT=5000

# Public phone signup: browser MSG91 Web SDK and legacy REST OTP are separate
# paths. All gates stay off until the selected provider integration and real
# operator contact are configured and verified. Never commit actual credentials.
APP_DISPLAY_NAME=SeatPal
PUBLIC_OPERATOR_NAME=
PUBLIC_SUPPORT_EMAIL=
PHONE_AUTH_ENABLED=0
PHONE_AUTH_HMAC_KEY=
PHONE_AUTH_DAILY_LIMIT=
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_AUTH_KEY=
# Legacy REST OTP path; required for native OTP, phone recovery, and phone changes.
MSG91_CONTRACT_VERIFIED=0
# Browser Web SDK path; does not enable native OTP or account recovery.
PHONE_AUTH_SDK_ENABLED=0
MSG91_SDK_CONTRACT_VERIFIED=0
MSG91_PROVIDER_ABUSE_CONTROLS_CONFIRMED=0
# Optional verified backup-email recovery for real phone accounts. Keep disabled
# until both phone OTP and email delivery have been configured and verified.
# Generate/store the stable Fernet key privately; rotating it requires migration.
# A connected Codex mailbox does not provide the deployed app with this API token.
# See docs/backup-email-contract.md. Never commit real keys or API credentials.
BACKUP_EMAIL_ENABLED=0
BACKUP_EMAIL_ENCRYPTION_KEY=
BACKUP_EMAIL_DAILY_LIMIT=100
HOSTINGER_MAIL_API_TOKEN=
HOSTINGER_MAILBOX_RESOURCE_ID=

# Retains the existing password-protected development identities and staff login.
DEMO_PASSWORD_ENABLED=1

# Private identity and driver evidence: stable shared Fernet key, generated privately and kept
# in secret storage. Never commit a real key. Empty/malformed/wrong key disables
# new evidence writes and decryption; changing a key is not a ciphertext migration.
# See docs/identity-review-contract.md and docs/driver-evidence-storage.md.
# Driver legacy BLOBs need explicit offline conversion; --check must pass before intake.
IDENTITY_EVIDENCE_KEY=
